<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.product.query.mapper.ProductQueryMapper">

    <resultMap id="ProductQueryMap"
               type="com.b101.dib.product.query.dto.ProductQueryDto">

        <id property="productId" column="product_id"/>
        <result property="memberId" column="member_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="condition" column="condition"/>
        <result property="modelName" column="model_name"/>
        <result property="releaseYear" column="release_year"/>
        <result property="marketPrice" column="market_price"/>
        <result property="thumbnailUrl" column="thumbnail_url"/>
        <result property="status" column="status"/>
        <result property="embedding" column="embedding"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="deletedAt" column="deleted_at"/>

    </resultMap>

    <select id="findAll" resultMap="ProductQueryMap">
        SELECT
            p.product_id,
            p.member_id,
            p.category_id,
            p.title,
            p.description,
            p.condition,
            p.model_name,
            p.release_year,
            p.market_price,
            p.thumbnail_url,
            p.status,
            p.embedding,
            p.created_at,
            p.updated_at,
            p.deleted_at
        FROM product p
        ORDER BY p.created_at DESC
    </select>

</mapper>