<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.report.repository.ReportMapper">

    <resultMap id="ReportQueryMap"
        type="com.b101.dib.report.query.dto.ReportQueryDto">
        <id property="reportId" column="report_id" />
        <result property="content" column="content" />
        <result property="type" column="type" />
        <result property="auctionId" column="auction_id" />
        <result property="orderId" column="order_id" />
        <result property="reportTargetId" column="report_target_id" />
        <result property="status" column="status" />
        <result property="createdAt" column="created_at" />
        <result property="processedAt" column="processed_at" />
    </resultMap>

    <select id="findByMemberId" resultMap="ReportQueryMap">
        SELECT
            r.report_id,
            r.content,
            r.type,
            r.auction_id,
            r.order_id,
            r.report_target_id,
            r.status,
            r.created_at,
            r.processed_at
        FROM report r
        WHERE r.member_id = #{memberId}
        <if test="type != null">
            AND r.type = #{type}::report_type
        </if>
        <if test="status != null">
            AND r.status = #{status}::report_status
        </if>
        ORDER BY r.created_at DESC, r.report_id DESC
    </select>
</mapper>