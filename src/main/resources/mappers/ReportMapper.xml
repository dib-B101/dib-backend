<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.report.repository.ReportMapper">

    <resultMap id="ReportQueryMap"
        type="com.b101.dib.report.query.dto.ReportQueryDto">
        <id property="reportId" column="report_id" />
        <result property="content" column="content" />
        <result property="type" column="type" />
        <result property="auctionId" column="auction_id" />
        <result property="orderId" column="order_id" />
        <result property="reportTargetId" column="report_target_id" />
        <result property="status" column="status" />
        <result property="createdAt" column="created_at" />
        <result property="processedAt" column="processed_at" />
    </resultMap>

    <select id="findByMemberId" resultMap="ReportQueryMap">
        SELECT
            r.report_id,
            r.content,
            r.type,
            r.auction_id,
            r.order_id,
            r.report_target_id,
            r.status,
            r.created_at,
            r.processed_at
        FROM report r
        WHERE r.member_id = #{memberId}
        <if test="type != null">
            AND r.type = #{type}::report_type
        </if>
        <if test="status != null">
            AND r.status = #{status}::report_status
        </if>
        ORDER BY r.created_at DESC, r.report_id DESC
    </select>
    
        <resultMap id="AdminReportQueryMap"
        type="com.b101.dib.report.query.dto.AdminReportQueryDto">
        <id property="reportId" column="report_id" />
        <result property="memberId" column="member_id" />
        <result property="memberNickname" column="member_nickname" />
        <result property="reportTargetId" column="report_target_id" />
        <result property="reportTargetNickname" column="report_target_nickname" />
        <result property="content" column="content" />
        <result property="type" column="type" />
        <result property="auctionId" column="auction_id" />
        <result property="orderId" column="order_id" />
        <result property="status" column="status" />
        <result property="createdAt" column="created_at" />
        <result property="processedAt" column="processed_at" />
    </resultMap>

    <select id="findAll" resultMap="AdminReportQueryMap">
        SELECT
            r.report_id,
            r.member_id,
            reporter.nickname AS member_nickname,
            r.report_target_id,
            target.nickname AS report_target_nickname,
            r.content,
            r.type,
            r.auction_id,
            r.order_id,
            r.status,
            r.created_at,
            r.processed_at
        FROM report r
        JOIN member reporter ON reporter.member_id = r.member_id
        LEFT JOIN member target ON target.member_id = r.report_target_id
        <where>
            <if test="type != null">
                AND r.type = #{type}::report_type
            </if>
            <if test="status != null">
                AND r.status = #{status}::report_status
            </if>
        </where>
        ORDER BY
            CASE r.status WHEN 'PENDING' THEN 0 ELSE 1 END,
            r.created_at DESC
    </select>
</mapper>