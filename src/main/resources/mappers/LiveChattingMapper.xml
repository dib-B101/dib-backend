<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.liveChatting.repository.LiveChattingMapper">

	<resultMap id="LiveChattingQueryMap"
		type="com.b101.dib.liveChatting.query.dto.LiveChattingQueryDto">

		<id property="liveChattingId" column="live_chatting_id" />
		<result property="liveBroadcastId" column="live_broadcast_id" />
		<result property="memberId" column="member_id" />
		<result property="nickname" column="nickname" />
		<result property="content" column="content" />
		<result property="time" column="time" />

	</resultMap>

	<select id="findByLiveBroadcastId" resultMap="LiveChattingQueryMap">
		SELECT
			lc.live_chatting_id,
			lc.live_broadcast_id,
			lc.member_id,
			m.nickname,
			lc.content,
			lc.time
		FROM live_chatting lc
		LEFT JOIN member m ON m.member_id = lc.member_id
		WHERE lc.live_broadcast_id = #{liveBroadcastId}
		ORDER BY lc.time DESC
	</select>
	
</mapper>
