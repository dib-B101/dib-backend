<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.bookmark.repository.BookmarkMapper">

    <resultMap id="BookmarkQueryMap"
        type="com.b101.dib.bookmark.query.dto.BookmarkQueryDto">
        <id property="bookmarkId" column="report_id" />
        <result property="memberId" column="member_id" />
        <result property="productId" column="product_id" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <select id="findAll" resultMap="BookmarkQueryMap">
        SELECT
        	b.bookmark_id,
        	b.member_id,
        	b.product_id,
        	b.created_at
    	FROM bookmark b
    	ORDER BY b.created_at DESC
    </select>
    
    <select id="findByMemberId" resultMap="BookmarkQueryMap">
        SELECT
        	b.bookmark_id,
        	b.member_id,
        	b.product_id,
        	b.created_at
    	FROM bookmark b
    	WHERE b.member_id = #{memberId}
    	ORDER BY b.created_at DESC
    </select>
    
</mapper>