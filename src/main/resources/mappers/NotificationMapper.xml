<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.notification.repository.NotificationMapper">

    <resultMap id="NotificationQueryMap" type="com.b101.dib.notification.query.dto.NotificationQueryDto">
        <id property="notificationId" column="notification_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="read" column="is_read"/>
        <result property="auctionId" column="auction_id"/>
        <result property="productId" column="product_id"/>
        <result property="liveBroadcastId" column="live_broadcast_id"/>
        <result property="bidId" column="bid_id"/>
        <result property="orderId" column="order_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 내 알림 (최신순, 커서 = notification_id) -->
    <select id="findByMemberId" resultMap="NotificationQueryMap">
        SELECT
            n.notification_id,
            n.type,
            n.title,
            n.content,
            n.is_read,
            n.auction_id,
            n.product_id,
            n.live_broadcast_id,
            n.bid_id,
            n.order_id,
            n.created_at
        FROM notification n
        WHERE n.member_id = #{memberId}
        <if test="unreadOnly != null and unreadOnly">
            AND n.is_read = FALSE
        </if>
        <if test="cursor != null">
            AND n.notification_id &lt; #{cursor}
        </if>
        ORDER BY n.notification_id DESC
        LIMIT #{limit}
    </select>

</mapper>
