<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.bid.repository.BidMapper">

    <resultMap id="BidHistoryQueryMap" type="com.b101.dib.bid.query.dto.BidHistoryQueryDto">
        <id property="bidId" column="bid_id"/>
        <result property="auctionId" column="auction_id"/>
        <result property="bidderId" column="member_id"/>
        <result property="amount" column="amount"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 경매 입찰 내역 (최신순, 커서 = bid_id) -->
    <select id="findByAuctionId" resultMap="BidHistoryQueryMap">
        SELECT
            b.bid_id,
            b.auction_id,
            b.member_id,
            b.amount,
            b.created_at
        FROM bid b
        WHERE b.auction_id = #{auctionId}
        <if test="cursor != null">
            AND b.bid_id &lt; #{cursor}
        </if>
        ORDER BY b.bid_id DESC
        LIMIT #{limit}
    </select>

    <resultMap id="MyBidQueryMap" type="com.b101.dib.bid.query.dto.MyBidQueryDto">
        <id property="bidId" column="bid_id"/>
        <result property="auctionId" column="auction_id"/>
        <result property="amount" column="amount"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 내 입찰 내역 (최신순) -->
    <select id="findByMemberId" resultMap="MyBidQueryMap">
        SELECT
            b.bid_id,
            b.auction_id,
            b.amount,
            b.created_at
        FROM bid b
        JOIN auction a ON a.auction_id = b.auction_id
        WHERE b.member_id = #{memberId}
        <if test="status != null">
            AND a.status = #{status}::auction_status
        </if>
        <if test="cursor != null">
            AND b.bid_id &lt; #{cursor}
        </if>
        ORDER BY b.bid_id DESC
        LIMIT #{limit}
    </select>

</mapper>
