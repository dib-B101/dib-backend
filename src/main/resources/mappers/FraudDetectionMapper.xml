<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.b101.dib.fraudDetection.repository.FraudDetectionMapper">

    <resultMap id="FraudDetectionQueryMap"
        type="com.b101.dib.fraudDetection.query.dto.FraudDetectionQueryDto">
        <id property="detectionId" column="detection_id" />
        <result property="auctionId" column="auction_id" />
        <result property="memberId" column="member_id" />
        <result property="memberNickname" column="member_nickname" />
        <result property="bidId" column="bid_id" />
        <result property="ruleScore" column="rule_score" />
        <result property="mlScore" column="ml_score" />
        <result property="riskScore" column="risk_score" />
        <result property="predictedLabel" column="predicted_label" />
        <result property="decisionThreshold" column="decision_threshold" />
        <result property="modelVersion" column="model_version" />
        <result property="featureVersion" column="feature_version" />
        <result property="detectedAt" column="detected_at" />
    </resultMap>

    <select id="findAll" resultMap="FraudDetectionQueryMap">
        SELECT
            d.detection_id,
            d.auction_id,
            d.member_id,
            m.nickname AS member_nickname,
            d.bid_id,
            d.rule_score,
            d.ml_score,
            d.risk_score,
            d.predicted_label,
            d.decision_threshold,
            d.model_version,
            d.feature_version,
            d.detected_at
        FROM fraud_detection d
        JOIN member m ON m.member_id = d.member_id
        <where>
            <if test="auctionId != null">
                AND d.auction_id = #{auctionId}
            </if>
            <if test="memberId != null">
                AND d.member_id = #{memberId}
            </if>
            <if test="riskScoreGte != null">
                AND d.risk_score <![CDATA[ >= ]]> #{riskScoreGte}
            </if>
        </where>
        ORDER BY d.risk_score DESC, d.detected_at DESC
    </select>
</mapper>
